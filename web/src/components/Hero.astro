---
interface Props {
  count: number;
}

const { count } = Astro.props;
const BASE = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-glow" aria-hidden="true"></div>

  <div class="hero-content">
    <div class="hero-eyebrow">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M7 1L8.5 5.5H13L9.5 8L11 12.5L7 10L3 12.5L4.5 8L1 5.5H5.5L7 1Z"
          fill="currentColor"
        />
      </svg>
      AI-Powered Game Development
    </div>

    <h1 class="hero-title">
      {count} Skills for<br />
      <span class="accent">FXGL with AI</span>
    </h1>

    <p class="hero-subtitle">
      Canonical, tool-agnostic coding skills that wire Claude&nbsp;Code, GitHub&nbsp;Copilot,
      and Cursor directly into your FXGL game development workflow.
    </p>

    <div class="hero-stats">
      <span class="hero-stat">
        <span class="hero-stat-dot"></span>
        {count} skills
      </span>
      <span class="hero-stat">
        <span class="hero-stat-dot"></span>
        FXGL 21.x
      </span>
      <span class="hero-stat">
        <span class="hero-stat-dot"></span>
        Java 17+
      </span>
      <span class="hero-stat">
        <span class="hero-stat-dot"></span>
        Open Source
      </span>
    </div>

    <div class="hero-actions">
      <a href="#skills" class="btn-primary">
        Browse Skills
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M8 3L8 13M8 13L13 8M8 13L3 8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
      <a
        href="https://github.com/JohannesRabauer/fxgl-skills/releases/latest/download/fxgl-skills.zip"
        class="btn-secondary"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M8 2v8M5 7l3 3 3-3"/>
          <rect x="2" y="11" width="12" height="3" rx="1"/>
        </svg>
        Download Skills
      </a>
      <a
        href="https://github.com/JohannesRabauer/fxgl-skills"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
          />
        </svg>
        View on GitHub
      </a>
    </div>
  </div>
</section>
