---
import type { AnnotatedSkill } from '../types/skills';

interface Props {
  skill: AnnotatedSkill;
}

const { skill } = Astro.props;
const BASE = import.meta.env.BASE_URL;

const badgeLabel: Record<string, string> = {
  '2d': '2D Game',
  '3d': '3D Game',
  subsystem: 'Subsystem',
  workflow: 'Workflow',
};

// Show specific tags — skip generic "fxgl" and "java" tags
const specificTags = skill.tags.filter(t => t !== 'fxgl' && t !== 'java').slice(0, 4);

const fxglVersion = skill.metadata?.['fxgl-version'] ?? '21.x';
---

<article
  class="skill-card"
  style={`--index: ${skill.cardIndex}`}
  data-ui-category={skill.uiCategory}
  data-name={skill.name}
  data-title={skill.title}
  data-tags={skill.tags.join(',')}
  data-description={skill.description}
  data-triggers={skill.triggers.join(', ')}
  data-compatibility={skill.compatibility}
  data-path={skill.path}
>
  <div
    class={`card-link badge-${skill.uiCategory}`}
    role="button"
    tabindex="0"
    aria-label={`Open ${skill.title}`}
  >
    <div class="card-header">
      <span class={`badge badge--${skill.uiCategory}`}>{badgeLabel[skill.uiCategory]}</span>
      <span class="card-version">FXGL {fxglVersion}</span>
    </div>

    <h3 class="card-title">{skill.title}</h3>
    <p class="card-desc">{skill.description}</p>

    <div class="card-tags">
      {specificTags.map(tag => <span class="tag">{tag}</span>)}
    </div>
  </div>
</article>
